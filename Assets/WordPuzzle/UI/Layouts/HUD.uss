/*
 * Ported from "Word Wonders Screens" S02 (Gameplay HUD).
 * Design canvas is 360x780; the UI panel reference is 1080x1920, so every design px is x3.
 * Flat fills use background-color + border-radius (exact in USS); only the gold gradient
 * needs a sprite, since USS has no gradient support.
 */

.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding-top: 48px;
    background-color: rgba(0, 0, 0, 0);
}

/* ------------------------------------------------------------------ top bar */
.hud-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-left: 30px;
    padding-right: 30px;
}

/* Sized to match the pills beside it, so the bar reads as one row rather than a button
   next to some badges. */
.icon-btn-round {
    background-color: rgba(12, 32, 60, 0.68);
    border-radius: 54px;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.85);
    width: 108px;
    height: 108px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale, opacity, background-color;
    transition-duration: 0.12s, 0.12s, 0.12s;
}

/* Sprite icons rather than font glyphs, which only render if the active font has them. */
.btn-icon {
    width: 48px;
    height: 48px;
}

.icon-pause {
    background-image: url("../../Sprites/slices/icon_pause.png");
}

.action-icon {
    width: 78px;
    height: 78px;
}

.icon-shuffle {
    background-image: url("../../Sprites/slices/icon_shuffle_ring.png");
}

.icon-hint {
    background-image: url("../../Sprites/slices/icon_hint_bulb.png");
}

/* Takes the middle and is allowed to grow, so a long chapter name has somewhere to go
   instead of forcing the readouts off the edge. */
.level-info-pill {
    flex-grow: 1;
    max-width: 480px;
    margin: 0 18px;
    min-height: 96px;
    background-image: none;
    background-color: rgba(11, 48, 96, 0.90);
    border-radius: 28px;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.65);
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
}

.hud-level-text {
    font-size: 32px;
    color: #ffffff;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* Secondary by design: the chapter name is flavour, the level number is the fact the
   player is looking for. */
.hud-chapter-text {
    font-size: 20px;
    color: #ffd447;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-top: 2px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 100%;
}

/* ------------------------------------------------- readouts (timer + coins)
   Grouped so the two numbers sit together as one block on the right. */
.hud-readouts {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.stat-pill {
    height: 96px;
    min-width: 124px;
    margin-left: 12px;
    background-image: none;
    background-color: rgba(11, 48, 96, 0.90);
    border-radius: 28px;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.65);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
}

.stat-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: #ffffff;
}

/* Clock face drawn in USS - a ring with a tick, so no sprite is needed. */
.timer-icon {
    width: 33px;
    height: 33px;
    margin-right: 12px;
    border-radius: 18px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.75);
}

.coin-icon {
    width: 39px;
    height: 39px;
    margin-right: 12px;
    background-image: url("../../Sprites/slices/icon_coin.png");
}

.coin-text {
    color: #f6dd9a;
}

/* Only shown in Time Trial; the view hides it entirely in Classic so the top bar keeps
   its three-item balance. */
.timer-pill {
    margin-right: 18px;
}

.timer-text {
    color: #ffd0b0;
}

/* ------------------------------------------------------------------ lower stack */
.hud-lower {
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    /* Devices file reserves a safeBottom of r(24) below the action row on every device. */
    padding-bottom: 72px;
}

.word-toast {
    /* Same scheme as the preview: a percentage of the screen, just above it. */
    position: absolute;
    bottom: 50%;
    left: 50%;
    translate: -50% 0;

    /* Height grows with the text: the card carries a wrapped definition */
    width: 1150px;
    max-width: 92%;
    min-height: 160px;
    padding: 24px 50px;
    background-image: none;
    background-color: rgba(11, 48, 96, 0.96);
    border-radius: 28px;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.65);
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.9 0.9;
    translate: -50% 18px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.2s, 0.2s, 0.2s;
}

.word-toast-close {
    position: absolute;
    top: 14px;
    right: 18px;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
    font-size: 26px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.word-toast-close:hover {
    background-color: rgba(255, 255, 255, 0.35);
    scale: 1.08 1.08;
}

.word-toast-close:active {
    scale: 0.92 0.92;
    opacity: 0.8;
}

.word-toast--visible {
    opacity: 1;
    scale: 1 1;
    translate: -50% 0;
}

.word-toast-word {
    font-size: 50px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 2px;
}

/* The status caption: small, spaced and dimmed */
.word-toast-status {
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffd859;
    letter-spacing: 2px;
    margin-top: 4px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.layout--portrait .word-toast-status {
    font-size: 28px;
}

.layout--landscape .word-toast-status {
    font-size: 24px;
}

.word-toast-note {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 6px;
    /* Definitions are sentences, not captions: they must wrap and stay inside the toast
       instead of stretching it off both edges of the screen. */
    white-space: normal;
    width: 100%;
    -unity-text-align: middle-center;
}

/* Positioned as a fraction of the screen, not with a pixel margin.
   The wheel and grid are placed in viewport coordinates by the gameplay code (wheel centred
   at y 0.30, grid above y 0.50), so anything in the UI that has to sit between them must be
   expressed the same way. A fixed margin was a number tuned for one phone: it put the
   preview inside the grid on this one. */
.word-preview-box {
    position: absolute;
    bottom: 41%;
    left: 50%;
    translate: -50% 0;
    background-image: none;
    background-color: rgba(11, 48, 96, 0.92);
    border-radius: 26px;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.65);
    align-items: center;
    justify-content: center;
    min-height: 88px;
    min-width: 200px;
    padding: 10px 36px;
}

.word-preview-text {
    font-size: 56px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 6px;
}

/* ------------------------------------------------------------------ action buttons
   Unified deep ocean blue dock parent box housing all 3 action buttons. */
.hud-bottom-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: rgba(11, 48, 96, 0.92);
    border-radius: 40px;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.65);
    padding: 14px 20px 16px 20px;
}

.action-column {
    align-items: center;
    justify-content: center;
    min-width: 144px;
    width: auto;
    margin: 0 8px;
    background-color: transparent;
    border-width: 0;
    padding: 0 4px;
}

.action-btn {
    background-image: none;
    background-color: transparent;
    border-width: 0;
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-bottom: 4px;
    transition-property: scale, opacity;
    transition-duration: 0.12s, 0.12s;
}

.hint-color,
.words-color {
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

/* Kept clickable on purpose - tapping it plays the rejection cue, which tells the player
   why nothing happened. A hard-disabled button would swallow the tap silently. */
.action-btn--unaffordable {
    opacity: 0.45;
}

.action-label {
    width: 100%;
    white-space: nowrap;
    -unity-text-align: middle-center;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #ffd859;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(4, 10, 22, 1.0);
    margin-top: 4px;
}

/* ------------------------------------------------------------------ press feedback */
.icon-btn-round:hover,
.action-btn:hover {
    scale: 1.05 1.05;
}

.icon-btn-round:active,
.action-btn:active {
    scale: 0.93 0.93;
    opacity: 0.85;
}

/* Invalid word: the design ships a red variant of the preview bar for exactly this.
   Applied briefly on submit, then removed. */
.word-preview-box--error {
    background-image: url("../../Sprites/slices/bar_word_preview_error.png");
}

.word-preview-text--error {
    color: #ffd9d9;
}

/* Repeat of an already-credited word. Glass rather than gold: it is an
   acknowledgement, not a reward, so it must not read like a payout. */
.word-toast--neutral {
    background-image: none;
    background-color: rgba(18, 38, 68, 0.94);
    border-color: rgba(255, 255, 255, 0.45);
}

.word-toast--neutral .word-toast-word {
    color: #e8f0f0;
}

.word-toast--neutral .word-toast-note {
    color: rgba(255, 255, 255, 0.6);
}


/* ============================================================ landscape
   The wheel moves to the left half (x: 22%, y: 45%) and the grid takes the right (x: 45% - 97%).
   The word preview and toast sit directly above the letter wheel (left: 22%, bottom: 74%),
   and the action buttons stay neatly on the left beneath the wheel column (left: 0, width: 44%).
*/

.layout--landscape .word-preview-box {
    left: 22%;
    bottom: 78%;
    translate: -50% 0;
    min-height: 80px;
    min-width: 180px;
    padding: 8px 32px;
    border-radius: 24px;
}

.layout--landscape .word-toast {
    left: 50%;
    bottom: 48%;
    translate: -50% 0;
    width: 58%;
    margin-bottom: 0;
}

.layout--landscape .hud-lower {
    position: absolute;
    bottom: 35px;
    left: 50%;
    translate: -50% 0;
    width: auto;
    align-items: center;
    justify-content: center;
    padding-bottom: 0;
}

.layout--landscape .hud-bottom-actions {
    width: auto;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 48, 96, 0.92);
    border-radius: 36px;
    border-width: 2.5px;
    border-color: rgba(255, 255, 255, 0.65);
    padding: 12px 18px 14px 18px;
}

/* Compact top bar: landscape is short, and the bar is competing with the grid for height. */
.layout--landscape .icon-btn-round {
    width: 72px;
    height: 72px;
    border-radius: 20px;
}

.layout--landscape .btn-icon {
    width: 34px;
    height: 34px;
}

.layout--landscape .level-info-pill {
    min-height: 72px;
    height: 72px;
    max-width: 380px;
    border-radius: 20px;
    padding: 6px 18px;
}

.layout--landscape .hud-level-text {
    font-size: 25px;
    letter-spacing: 1.5px;
}

.layout--landscape .hud-chapter-text {
    font-size: 16px;
    letter-spacing: 1px;
}

.layout--landscape .stat-pill {
    min-height: 72px;
    height: 72px;
    border-radius: 20px;
    padding: 0 16px;
}

.layout--landscape .stat-text {
    font-size: 25px;
}

.layout--landscape .coin-icon {
    width: 30px;
    height: 30px;
    margin-right: 8px;
}

.layout--landscape .timer-icon {
    width: 26px;
    height: 26px;
    margin-right: 8px;
}

.layout--landscape .action-btn {
    width: 90px;
    height: 90px;
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.layout--landscape .action-icon {
    width: 60px;
    height: 60px;
}

.layout--landscape .action-column {
    min-width: 140px;
    width: auto;
    margin: 0 8px;
    background-color: transparent;
    border-width: 0;
    padding: 0 4px;
}

.layout--landscape .action-label {
    white-space: nowrap;
    font-size: 20px;
    margin-top: 4px;
}

/* ============================================================ word list */
.words-color {
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.icon-words {
    background-image: url("../../Sprites/slices/icon_words.png");
    -unity-background-image-tint-color: #ffffff;
}

/* Absolute inset rather than 100%: same reason as the victory scrim - the HUD root does not
   stretch, so a percentage size would collapse and the scrim would not cover the screen. */
.words-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 10, 16, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

.words-panel--open {
    display: flex;
}

.words-panel-card {
    background-image: url("../../Sprites/slices/panel_modal.png");
    -unity-slice-left: 57;
    -unity-slice-right: 57;
    -unity-slice-top: 57;
    -unity-slice-bottom: 57;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 82%;
    max-height: 76%;
    padding: 48px 54px;
}

.words-panel-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.words-panel-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #f6dd9a;
    letter-spacing: 3px;
}

.words-panel-close {
    background-image: url("../../Sprites/slices/btn_icon_round.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 84px;
    height: 84px;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.75);
    padding: 0;
}

.words-panel-scroll {
    width: 100%;
    flex-grow: 1;
}

.words-panel-list {
    width: 100%;
}

/* A row per word, stacked: the meaning is a sentence, so the words cannot sit side by side
   as chips - each needs the full width to read. */
.word-row {
    width: 100%;
    padding: 18px 24px;
    margin-bottom: 12px;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.06);
}

/* Unsolved rows recede: they carry no meaning, so they should not compete with the ones
   that do. */
.word-row--hidden {
    background-color: rgba(255, 255, 255, 0.03);
}

.word-row-word {
    font-size: 34px;
    -unity-font-style: bold;
    color: #f6dd9a;
    letter-spacing: 4px;
}

.word-row-word--bonus {
    color: #9fd4a8;
}

.word-row-pos {
    font-size: 25px;
    -unity-font-style: italic;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 4px;
}

.word-row-text {
    font-size: 27px;
    color: rgba(255, 255, 255, 0.8);
    white-space: normal;
}

.words-panel-subhead {
    width: 100%;
    font-size: 27px;
    -unity-font-style: bold;
    color: rgba(246, 221, 154, 0.7);
    letter-spacing: 3px;
    margin-bottom: 12px;
}

/* ============================================================ portrait toast
   A phone is narrow, so the same pill holds far fewer words per line and a definition that
   was two lines in landscape becomes four. Widened to nearly the full screen and set in a
   larger type size, since on a phone the toast is read at arm's length. */
.layout--portrait .word-toast {
    width: 96%;
    min-height: 240px;
    padding: 36px 42px;
}

.layout--portrait .word-toast-word {
    font-size: 60px;
}

.layout--portrait .word-toast-note {
    font-size: 40px;
}

/* ============================================================ landscape toast
   Sized as a share of the screen rather than in reference pixels. The panel matches a
   1080-wide reference, so a fixed 1150px pill that fills a phone shrinks to a quarter of a
   wide landscape window - which is how the definition ended up unreadable there. */
.layout--landscape .word-toast {
    width: 58%;
    min-height: 160px;
    padding: 24px 36px;
    left: 50%;
    bottom: 48%;
    translate: -50% 0;
}

.layout--landscape .word-toast-word {
    font-size: 56px;
}

.layout--landscape .word-toast-note {
    font-size: 38px;
}
