/*
 * Ported from "Word Wonders Screens" S02 (Gameplay HUD).
 * Design canvas is 360x780; the UI panel reference is 1080x1920, so every design px is x3.
 * Flat fills use background-color + border-radius (exact in USS); only the gold gradient
 * needs a sprite, since USS has no gradient support.
 */

.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding-top: 48px;
    background-color: rgba(0, 0, 0, 0);
}

/* ------------------------------------------------------------------ top bar */
.hud-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-left: 30px;
    padding-right: 30px;
}

/* Sized to match the pills beside it, so the bar reads as one row rather than a button
   next to some badges. */
.icon-btn-round {
    background-image: url("../../Sprites/slices/btn_icon_round.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 108px;
    height: 108px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale, opacity;
    transition-duration: 0.12s, 0.12s;
}

/* Sprite icons rather than font glyphs, which only render if the active font has them. */
.btn-icon {
    width: 48px;
    height: 48px;
}

.icon-pause {
    background-image: url("../../Sprites/slices/icon_pause.png");
}

.action-icon {
    width: 78px;
    height: 78px;
}

.icon-shuffle {
    background-image: url("../../Sprites/slices/icon_shuffle_ring.png");
}

.icon-hint {
    background-image: url("../../Sprites/slices/icon_hint_bulb.png");
}

/* Takes the middle and is allowed to grow, so a long chapter name has somewhere to go
   instead of forcing the readouts off the edge. */
.level-info-pill {
    flex-grow: 1;
    max-width: 480px;
    margin: 0 18px;
    min-height: 108px;
    background-image: url("../../Sprites/slices/pill_hud.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 12px 30px;
}

.hud-level-text {
    font-size: 33px;
    color: #ffffff;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* Secondary by design: the chapter name is flavour, the level number is the fact the
   player is looking for. */
.hud-chapter-text {
    font-size: 21px;
    color: rgba(255, 255, 255, 0.42);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 2px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 100%;
}

/* ------------------------------------------------- readouts (timer + coins)
   Grouped so the two numbers sit together as one block on the right. */
.hud-readouts {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.stat-pill {
    height: 108px;
    min-width: 132px;
    margin-left: 12px;
    background-image: url("../../Sprites/slices/pill_hud.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
}

.stat-text {
    font-size: 33px;
    -unity-font-style: bold;
    color: #ffffff;
}

/* Clock face drawn in USS - a ring with a tick, so no sprite is needed. */
.timer-icon {
    width: 33px;
    height: 33px;
    margin-right: 12px;
    border-radius: 18px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.75);
}

.coin-icon {
    width: 39px;
    height: 39px;
    margin-right: 12px;
    background-image: url("../../Sprites/slices/icon_coin.png");
}

.coin-text {
    color: #f6dd9a;
}

/* Only shown in Time Trial; the view hides it entirely in Classic so the top bar keeps
   its three-item balance. */
.timer-pill {
    margin-right: 18px;
}

.timer-text {
    color: #ffd0b0;
}

/* ------------------------------------------------------------------ lower stack */
.hud-lower {
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    /* Devices file reserves a safeBottom of r(24) below the action row on every device. */
    padding-bottom: 72px;
}

.word-toast {
    /* Height grows with the text: the pill now carries a wrapped definition, not just a
       one-line caption, so a fixed height would clip it. */
    width: 820px;
    min-height: 132px;
    padding: 21px 36px;
    background-image: url("../../Sprites/slices/pill_toast.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    border-width: 0;
    opacity: 0;
    scale: 0.9 0.9;
    translate: 0 18px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.2s, 0.2s, 0.2s;
}

.word-toast--visible {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.word-toast-word {
    font-size: 39px;
    -unity-font-style: bold;
    color: #4a2c05;
    letter-spacing: 1px;
}

.word-toast-note {
    font-size: 27px;
    -unity-font-style: bold;
    color: rgba(74, 44, 5, 0.7);
    margin-top: 3px;
    /* Definitions are sentences, not captions: they must wrap and stay inside the toast
       instead of stretching it off both edges of the screen. */
    white-space: normal;
    width: 100%;
    -unity-text-align: middle-center;
}

.word-preview-box {
    background-image: url("../../Sprites/slices/bar_word_preview.png");
    -unity-slice-left: 58;
    -unity-slice-right: 58;
    -unity-slice-top: 58;
    -unity-slice-bottom: 58;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    min-height: 126px;
    min-width: 240px;
    padding: 0 60px;
    /* Reserves the vertical band the world-space letter wheel occupies (220 design px
       tall + 20 gap, x3). The wheel is rendered by the camera, not by this panel, so the
       space has to be held open here or the preview would sit on top of it. */
    margin-bottom: 720px;
}

.word-preview-text {
    font-size: 69px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 9px;
}

/* ------------------------------------------------------------------ action buttons
   The design puts the caption under the button rather than inside it. */
.hud-bottom-actions {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.action-column {
    align-items: center;
    width: 222px;
    margin: 0 24px;
}

.action-btn {
    background-image: url("../../Sprites/slices/btn_icon_square_glass.png");
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-top: 44;
    -unity-slice-bottom: 44;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 168px;
    height: 168px;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-bottom: 15px;
    transition-property: scale, opacity;
    transition-duration: 0.12s, 0.12s;
}

.hint-color {
    background-image: url("../../Sprites/slices/btn_icon_square_gold.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-width: 0;
    color: #4a2c05;
}

/* Kept clickable on purpose - tapping it plays the rejection cue, which tells the player
   why nothing happened. A hard-disabled button would swallow the tap silently. */
.action-btn--unaffordable {
    opacity: 0.45;
}

.action-label {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.7);
}

/* ------------------------------------------------------------------ press feedback */
.icon-btn-round:hover,
.action-btn:hover {
    scale: 1.05 1.05;
}

.icon-btn-round:active,
.action-btn:active {
    scale: 0.93 0.93;
    opacity: 0.85;
}

/* Invalid word: the design ships a red variant of the preview bar for exactly this.
   Applied briefly on submit, then removed. */
.word-preview-box--error {
    background-image: url("../../Sprites/slices/bar_word_preview_error.png");
}

.word-preview-text--error {
    color: #ffd9d9;
}

/* Repeat of an already-credited word. Glass rather than gold: it is an
   acknowledgement, not a reward, so it must not read like a payout. */
.word-toast--neutral {
    background-image: url("../../Sprites/slices/pill_hud.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
}

.word-toast--neutral .word-toast-word {
    color: #e8f0f0;
}

.word-toast--neutral .word-toast-note {
    color: rgba(255, 255, 255, 0.6);
}


/* ============================================================ landscape
   The wheel moves to the left half and the grid takes the right, so the lower stack no
   longer reserves a tall band beneath itself - that space is now the wheel's column, not
   empty screen. The word preview and the action buttons move to the right of the wheel. */

.layout--landscape .word-preview-box {
    /* Portrait holds 720px open for the world-space wheel below. In landscape the wheel is
       beside the UI, not under it, so that reservation is pure wasted height. */
    margin-bottom: 24px;
}

.layout--landscape .hud-lower {
    padding-bottom: 36px;
}

.layout--landscape .word-toast {
    width: 640px;
    margin-bottom: 18px;
}

/* Compact top bar: landscape is short, and the bar is competing with the grid for height. */
.layout--landscape .icon-btn-round {
    width: 84px;
    height: 84px;
}

.layout--landscape .btn-icon {
    width: 39px;
    height: 39px;
}

.layout--landscape .level-info-pill,
.layout--landscape .stat-pill {
    min-height: 84px;
    height: 84px;
}

.layout--landscape .action-btn {
    width: 132px;
    height: 132px;
}

.layout--landscape .action-icon {
    width: 60px;
    height: 60px;
}

.layout--landscape .action-column {
    width: 168px;
    margin: 0 15px;
}
