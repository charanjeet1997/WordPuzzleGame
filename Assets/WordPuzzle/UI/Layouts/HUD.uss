/*
 * Ported from "Word Wonders Screens" S02 (Gameplay HUD).
 * Design canvas is 360x780; the UI panel reference is 1080x1920, so every design px is x3.
 * Flat fills use background-color + border-radius (exact in USS); only the gold gradient
 * needs a sprite, since USS has no gradient support.
 */

.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding-top: 48px;
    background-color: rgba(0, 0, 0, 0);
}

/* ------------------------------------------------------------------ top bar */
.hud-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-left: 42px;
    padding-right: 42px;
}

.icon-btn-round {
    background-image: url("../../Sprites/slices/btn_icon_round.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 156px;
    height: 156px;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale, opacity;
    transition-duration: 0.12s, 0.12s;
}

/* Sprite icons rather than font glyphs, which only render if the active font has them. */
.btn-icon {
    width: 66px;
    height: 66px;
}

.icon-pause {
    background-image: url("../../Sprites/slices/icon_pause.png");
}

.action-icon {
    width: 78px;
    height: 78px;
}

.icon-shuffle {
    background-image: url("../../Sprites/slices/icon_shuffle_ring.png");
}

.icon-hint {
    background-image: url("../../Sprites/slices/icon_hint_bulb.png");
}

.level-info-pill {
    min-height: 96px;
    background-image: url("../../Sprites/slices/pill_hud.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 18px 42px;
}

.hud-level-text {
    font-size: 36px;
    color: #e8f0f0;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.hud-chapter-text {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.45);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.coin-pill {
    min-height: 96px;
    background-image: url("../../Sprites/slices/pill_hud.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: row;
    align-items: center;
    padding: 15px 33px;
}

.coin-icon {
    width: 45px;
    height: 45px;
    margin-right: 18px;
    background-image: url("../../Sprites/slices/icon_coin.png");
}

.coin-text {
    font-size: 39px;
    color: #f6dd9a;
    -unity-font-style: bold;
}

/* ------------------------------------------------------------------ lower stack */
.hud-lower {
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    /* Devices file reserves a safeBottom of r(24) below the action row on every device. */
    padding-bottom: 72px;
}

.word-toast {
    width: 660px;
    height: 132px;
    background-image: url("../../Sprites/slices/pill_toast.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    border-width: 0;
    opacity: 0;
    scale: 0.9 0.9;
    translate: 0 18px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.2s, 0.2s, 0.2s;
}

.word-toast--visible {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.word-toast-word {
    font-size: 39px;
    -unity-font-style: bold;
    color: #4a2c05;
    letter-spacing: 1px;
}

.word-toast-note {
    font-size: 27px;
    -unity-font-style: bold;
    color: rgba(74, 44, 5, 0.7);
    margin-top: 3px;
}

.word-preview-box {
    background-image: url("../../Sprites/slices/bar_word_preview.png");
    -unity-slice-left: 58;
    -unity-slice-right: 58;
    -unity-slice-top: 58;
    -unity-slice-bottom: 58;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    min-height: 126px;
    min-width: 240px;
    padding: 0 60px;
    /* Reserves the vertical band the world-space letter wheel occupies (220 design px
       tall + 20 gap, x3). The wheel is rendered by the camera, not by this panel, so the
       space has to be held open here or the preview would sit on top of it. */
    margin-bottom: 720px;
}

.word-preview-text {
    font-size: 69px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 9px;
}

/* ------------------------------------------------------------------ action buttons
   The design puts the caption under the button rather than inside it. */
.hud-bottom-actions {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.action-column {
    align-items: center;
    width: 222px;
    margin: 0 24px;
}

.action-btn {
    background-image: url("../../Sprites/slices/btn_icon_square_glass.png");
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-top: 44;
    -unity-slice-bottom: 44;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 168px;
    height: 168px;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-bottom: 15px;
    transition-property: scale, opacity;
    transition-duration: 0.12s, 0.12s;
}

.hint-color {
    background-image: url("../../Sprites/slices/btn_icon_square_gold.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-width: 0;
    color: #4a2c05;
}

/* Kept clickable on purpose - tapping it plays the rejection cue, which tells the player
   why nothing happened. A hard-disabled button would swallow the tap silently. */
.action-btn--unaffordable {
    opacity: 0.45;
}

.action-label {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.7);
}

/* ------------------------------------------------------------------ press feedback */
.icon-btn-round:hover,
.action-btn:hover {
    scale: 1.05 1.05;
}

.icon-btn-round:active,
.action-btn:active {
    scale: 0.93 0.93;
    opacity: 0.85;
}

/* Invalid word: the design ships a red variant of the preview bar for exactly this.
   Applied briefly on submit, then removed. */
.word-preview-box--error {
    background-image: url("../../Sprites/slices/bar_word_preview_error.png");
}

.word-preview-text--error {
    color: #ffd9d9;
}

/* Repeat of an already-credited word. Glass rather than gold: it is an
   acknowledgement, not a reward, so it must not read like a payout. */
.word-toast--neutral {
    background-image: url("../../Sprites/slices/pill_hud.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
}

.word-toast--neutral .word-toast-word {
    color: #e8f0f0;
}

.word-toast--neutral .word-toast-note {
    color: rgba(255, 255, 255, 0.6);
}
