/* Mode select. Same material and rhythm as the other cards: design px x3, gold on deep
   navy, sprite-backed panels rather than flat fills. */

.mode-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 10, 16, 0.82);
    align-items: center;
    justify-content: center;
}

.mode-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: #f6dd9a;
    letter-spacing: 4px;
    margin-bottom: 42px;
    flex-shrink: 0;
}

/* ------------------------------------------------------------------ options
   Stacked rows, in both orientations: icon left, text right. Side-by-side cards forced the
   description to wrap onto three lines and made each card narrow for no gain. */
.mode-list {
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 840px;
    flex-shrink: 0;
}

.mode-option {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding: 27px 30px;
    margin-bottom: 21px;
    background-image: url("../../Sprites/slices/panel_card.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    background-color: rgba(0, 0, 0, 0);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.1);
    /* Matches the 42px corner of panel_card.png. A USS border draws square corners of its
       own, so without this the selection outline boxed in a rounded card. */
    border-radius: 42px;
    opacity: 0.6;
    transition-property: opacity, border-color;
    transition-duration: 0.14s, 0.14s;
}

.mode-option--selected {
    opacity: 1;
    border-color: rgba(246, 221, 154, 0.9);
}

.mode-option:hover { opacity: 0.85; }
.mode-option:active { scale: 0.99 0.99; }

.mode-option-text {
    flex-grow: 1;
    align-items: flex-start;
    margin-left: 27px;
}

/* scale-to-fit, not the default stretch: the element is square but flex can hand it a
   non-square box, and the glyphs came out squashed. */
.mode-icon {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    background-image: url("../../Sprites/icon_mode_classic.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #f6dd9a;
}

/* Time Trial reads red-hot rather than calm gold. */
.mode-icon--timed {
    background-image: url("../../Sprites/icon_mode_timetrial.png");
    -unity-background-image-tint-color: #ff9a6e;
}

.mode-name {
    font-size: 39px;
    -unity-font-style: bold;
    color: #f6dd9a;
    letter-spacing: 3px;
}

.mode-desc {
    font-size: 25px;
    color: rgba(255, 255, 255, 0.7);
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 9px;
}

.mode-stat {
    font-size: 26px;
    -unity-font-style: bold;
    color: #e8f0f0;
    letter-spacing: 2px;
}

/* ------------------------------------------------------------------ actions */
.mode-play-button {
    width: 570px;
    height: 132px;
    margin-top: 24px;
    flex-shrink: 0;
    background-image: url("../../Sprites/slices/btn_primary.png");
    -unity-slice-left: 79;
    -unity-slice-right: 79;
    -unity-slice-top: 79;
    -unity-slice-bottom: 79;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #4a2c05;
    font-size: 45px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    transition-property: scale;
    transition-duration: 0.12s;
}

.mode-play-button:active { scale: 0.96 0.96; }

.mode-back {
    font-size: 33px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 2px;
    margin-top: 24px;
    padding: 12px 36px;
    flex-shrink: 0;
}
