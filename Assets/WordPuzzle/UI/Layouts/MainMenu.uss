/* Ported from "Word Wonders Screens" S01 (Main Menu). Design px x3. */

/* The panel paints the background itself, exactly as the splash screen does:
   scale-and-crop covers whatever shape the screen is, so there are no bars at the sides in
   landscape and it needs no world-space sprite or fitter behind it. */
.menu-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    background-image: url("../../Sprites/game_background.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(0, 0, 0, 0);
}

.menu-top-bar {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    padding: 60px 54px 0 54px;
}

/* Larger than the design's 40px (=120px) circles - they read too small on device. */
.icon-btn-round {
    background-image: url("../../Sprites/slices/btn_icon_round.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 168px;
    height: 168px;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale, opacity;
    transition-duration: 0.12s, 0.12s;
}

/* Icons are sprites, not font glyphs: a glyph only renders if the active font happens
   to include it, which is not guaranteed once the font is swapped. */
.btn-icon {
    width: 78px;
    height: 78px;
}

.icon-sound-on {
    background-image: url("../../Sprites/slices/icon_sound_on.png");
}

.icon-sound-off {
    background-image: url("../../Sprites/slices/icon_sound_off.png");
}

.icon-settings {
    background-image: url("../../Sprites/slices/icon_settings_gear.png");
}

.icon-btn-round:hover { scale: 1.05 1.05; }
.icon-btn-round:active { scale: 0.93 0.93; opacity: 0.85; }

/* Children keep their natural height (flex-shrink 0): compressing them made "WORDS" sit on
   top of "AURORA". Nothing clips it now because the panel shrink-to-fits, so the whole
   design is guaranteed to fit the screen whatever its shape. */
.center-content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 66px;
}

.center-content > * {
    flex-shrink: 0;
}

/* ------------------------------------------------------------------ title */
.title-lockup {
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 102px;
}

/* Explicit heights: a Label's line box is taller than its glyphs, and the negative margin
   below is measured against this rather than against whatever the font happens to report. */
.game-title {
    height: 132px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    font-size: 126px;
    -unity-font-style: bold;
    color: #f6dd9a;
    letter-spacing: 3px;
    text-shadow: 0 9px 0 rgba(0, 0, 0, 0.35);
}

/* Negative top margin pulls the wordmark up under the title, as in the design. */
.game-subtitle {
    height: 78px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    font-size: 72px;
    -unity-font-style: bold;
    color: #cfe8ea;
    letter-spacing: 18px;
    margin-top: -6px;
}

/* ------------------------------------------------------------------ chapter card */
.chapter-card {
    flex-shrink: 0;
    background-image: url("../../Sprites/slices/panel_card.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 100%;
    max-width: 810px;
    padding: 48px 54px;
    margin-bottom: 102px;
}

.chapter-card-row {
    flex-shrink: 0;
    min-height: 42px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.chapter-title {
    font-size: 33px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 4.5px;
}

.chapter-meta {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.4);
}

.chapter-name {
    height: 63px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
    font-size: 57px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-top: 27px;
    margin-bottom: 27px;
}

.level-subtitle {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.6);
}

.progress-dots {
    flex-direction: row;
    align-items: center;
}

.dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin-left: 12px;
    background-color: rgba(255, 255, 255, 0.25);
}

.dot--on {
    background-color: #e6b25a;
}

/* ------------------------------------------------------------------ play button */
.btn-primary {
    width: 650px;
    height: 160px;
    background-image: url("../../Sprites/slices/btn_primary.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-width: 0;
    color: #4a2c05;
    font-size: 63px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    transition-property: scale, opacity;
    transition-duration: 0.13s, 0.13s;
}

.btn-primary:hover { scale: 1.05 1.05; }
.btn-primary:active { scale: 0.95 0.95; opacity: 0.9; }

.btn-collection {
    width: 650px;
    padding: 24px;
    margin-top: 30px;
    border-radius: 42px;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 3px;
    border-color: rgba(246, 221, 154, 0.35);
    align-items: center;
    transition-property: scale, background-color;
    transition-duration: 0.13s, 0.13s;
}

/* Pulses only while onboarding is pointing at it. USS has no keyframes, so the view
   drives nothing here - the transition-free gold state is enough to draw the eye without
   an animation loop to manage. */
.btn-collection--prompt {
    background-color: rgba(246, 221, 154, 0.22);
    border-color: rgba(246, 221, 154, 0.9);
    scale: 1.03 1.03;
}

.btn-collection--prompt .btn-collection-count {
    color: #f6dd9a;
}

.btn-collection:hover { background-color: rgba(255, 255, 255, 0.11); }
.btn-collection:active { scale: 0.97 0.97; }

.btn-collection-title {
    font-size: 33px;
    -unity-font-style: bold;
    color: #f6dd9a;
    letter-spacing: 3px;
}

.btn-collection-count {
    font-size: 27px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 4px;
}

.menu-footer {
    height: 72px;
}

/* Sound off: dim the speaker so the state is visible on an icon-only button. */
.icon-btn--muted {
    opacity: 0.45;
}


/* ============================================================ landscape
   A short window cannot carry the full-size title lockup and the chapter card, so the
   type comes down rather than the layout scrambling. */

.layout--landscape .game-title {
    font-size: 84px;
    height: 90px;
}

.layout--landscape .game-subtitle {
    font-size: 48px;
    height: 54px;
    letter-spacing: 12px;
}

.layout--landscape .chapter-card {
    max-width: 720px;
    padding: 30px 42px;
}

.layout--landscape .chapter-name {
    font-size: 42px;
    height: 48px;
    margin-top: 15px;
    margin-bottom: 15px;
}

.layout--landscape .btn-primary {
    width: 480px;
    height: 120px;
    font-size: 48px;
}

.layout--landscape .btn-collection {
    width: 480px;
    padding: 15px;
    margin-top: 18px;
}
