<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" path="Assets/WordPuzzle/UI/Layouts/HUD.uxml">
    <ui:Style src="HUD.uss" />
    <ui:VisualElement name="hud-root" class="hud-container">

        <!-- Top bar. Pause sits alone on the left; level identity takes the centre and is
             allowed to grow; the numeric readouts group together on the right so the eye
             finds them in one place instead of scanning three competing pills. -->
        <ui:VisualElement class="hud-top-bar">
            <ui:Button name="btn-pause" text="" class="icon-btn-round">
                <ui:VisualElement class="btn-icon icon-pause" picking-mode="Ignore" />
            </ui:Button>

            <ui:VisualElement class="level-info-pill">
                <ui:Label name="lbl-level-number" text="LEVEL 1" class="hud-level-text" />
                <ui:Label name="lbl-chapter-title" text="" class="hud-chapter-text" />
            </ui:VisualElement>

            <ui:VisualElement class="hud-readouts">
                <ui:VisualElement name="timer-pill" class="stat-pill timer-pill">
                    <ui:VisualElement class="timer-icon" picking-mode="Ignore" />
                    <ui:Label name="lbl-timer" text="0:00" class="stat-text timer-text" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-pill coin-pill">
                    <ui:VisualElement class="coin-icon" />
                    <ui:Label name="lbl-coins" text="0" class="stat-text coin-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Positioned against the root, not the lower stack: these sit at a fraction of the
             screen height so they line up with the world-space grid and wheel. Inside the
             lower stack a percentage measured against that container's own small height,
             which put the preview behind the action buttons. -->
        <ui:VisualElement name="word-toast" class="word-toast">
            <ui:Button name="btn-toast-close" text="✕" class="word-toast-close" />
            <ui:Label name="lbl-toast-word" text="" class="word-toast-word" />
            <ui:Label name="lbl-toast-status" text="" class="word-toast-status" />
            <ui:Label name="lbl-toast-note" text="" class="word-toast-note" />
        </ui:VisualElement>

            <ui:VisualElement class="word-preview-box">
                <ui:Label name="lbl-word-preview" text="" class="word-preview-text" />
            </ui:VisualElement>

        <!-- Lower stack sits beneath the world-space grid and letter wheel -->
        <ui:VisualElement class="hud-lower">
            <ui:VisualElement class="hud-bottom-actions">
                <ui:VisualElement class="action-column">
                    <ui:Button name="btn-shuffle" text="" class="action-btn">
                        <ui:VisualElement class="action-icon icon-shuffle" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label text="SHUFFLE" class="action-label" />
                </ui:VisualElement>
                <ui:VisualElement class="action-column">
                    <ui:Button name="btn-hint" text="" class="action-btn hint-color">
                        <ui:VisualElement class="action-icon icon-hint" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label name="lbl-hint-cost" text="HINT · 5 LEFT" class="action-label" />
                </ui:VisualElement>
                <ui:VisualElement class="action-column">
                    <ui:Button name="btn-words" text="" class="action-btn words-color">
                        <ui:VisualElement class="action-icon icon-words" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label name="lbl-words-count" text="WORDS · 0/0" class="action-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Word list overlay, opened by the WORDS button. Hidden by default; the panel is
             built fresh each time it opens so it always reflects the current level. -->
        <ui:VisualElement name="words-panel" class="words-panel">
            <ui:VisualElement class="words-panel-card">
                <ui:VisualElement class="words-panel-head">
                    <ui:Label name="lbl-words-title" text="WORDS IN THIS LEVEL" class="words-panel-title" />
                    <ui:Button name="btn-words-close" text="✕" class="words-panel-close" />
                </ui:VisualElement>

                <ui:ScrollView name="words-panel-scroll" class="words-panel-scroll">
                    <ui:VisualElement name="words-panel-list" class="words-panel-list" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
