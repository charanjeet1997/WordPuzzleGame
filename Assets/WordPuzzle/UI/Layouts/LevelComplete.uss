/* Ported from "Word Wonders Screens" S04 (Level Complete). Design px x3.
   Absolute inset rather than width/height 100%: the overlay is parented into a panel whose
   root does not stretch, so percentage sizing collapses and the scrim never covers the screen. */

.victory-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 10, 16, 0.72);
    align-items: center;
    justify-content: center;
}

.victory-card {
    background-image: url("../../Sprites/slices/panel_modal.png");
    -unity-slice-left: 57;
    -unity-slice-right: 57;
    -unity-slice-top: 57;
    -unity-slice-bottom: 57;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 858px;
    border-width: 0;
    padding: 84px 72px;
    align-items: center;

    /* Entrance state; the shown class is added a frame later from code. */
    scale: 0.88 0.88;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.22s, 0.22s;
}

.victory-card--shown {
    scale: 1 1;
    opacity: 1;
}

/* Full width and centred, so in portrait the two columns stack and the card looks exactly
   as it did when these elements were direct children of it. */
.victory-col {
    width: 100%;
    align-items: center;
}

/* Moved between the columns by LevelCompleteView, so it must look right under either. */
.victory-actions {
    width: 100%;
    align-items: center;
}

.victory-title {
    font-size: 84px;
    -unity-font-style: bold;
    color: #ffd447;
    letter-spacing: 3px;
    margin-bottom: 45px;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
}

/* ------------------------------------------------------------------ stars
   Sprites, not emoji: the font has no colour-emoji glyphs, so a star character
   falls back to a flat monochrome outline. */
.stars-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 45px;
}

.star {
    width: 108px;
    height: 108px;
    margin: 0 15px;
    background-image: url("../../Sprites/slices/icon_star_off.png");
    scale: 0.6 0.6;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.28s, 0.28s;
}

.star--earned {
    background-image: url("../../Sprites/slices/icon_star_on.png");
}

.star--shown {
    scale: 1 1;
    opacity: 1;
}

/* ------------------------------------------------------------------ reward */
.reward-box {
    min-height: 96px;
    background-image: url("../../Sprites/slices/pill_hud.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 27px 54px;
    margin-bottom: 18px;
}

.reward-coin {
    width: 57px;
    height: 57px;
    margin-right: 24px;
    background-image: url("../../Sprites/slices/icon_coin.png");
}

.reward-text {
    font-size: 51px;
    -unity-font-style: bold;
    color: #f6dd9a;
}

.reward-subtext {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 27px;
}

/* ------------------------------------------------- word meanings
   Capped height with its own scroll: a level can be cleared with eight target words, and
   letting the list grow freely would push the NEXT LEVEL button off the card. */
.meanings-heading {
    font-size: 27px;
    -unity-font-style: bold;
    color: rgba(246, 221, 154, 0.75);
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.meanings-scroll {
    width: 100%;
    max-height: 420px;
    margin-bottom: 24px;
}

.meanings-list {
    width: 100%;
}

/* ------------------------------------------------- scrollbar
   UI Toolkit's default scroller is a grey Windows-style widget with arrow buttons at both
   ends - visually from a different application than the rest of this card. Slimmed to a
   thin gold thumb on a faint track, with the arrows removed. */
.meanings-scroll .unity-scroller--vertical {
    width: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-left: 9px;
}

/* The two arrow buttons: nobody taps them on a touch screen. */
.meanings-scroll .unity-scroller__low-button,
.meanings-scroll .unity-scroller__high-button {
    display: none;
}

.meanings-scroll .unity-base-slider--vertical {
    width: 18px;
    margin: 0;
}

.meanings-scroll .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 0;
    border-radius: 9px;
    width: 6px;
    left: 6px;
    margin: 0;
}

.meanings-scroll .unity-base-slider__dragger {
    background-color: rgba(246, 221, 154, 0.75);
    border-width: 0;
    border-radius: 9px;
    width: 8px;
    left: 5px;
    margin: 0;
}

.meanings-scroll .unity-base-slider__dragger:hover {
    background-color: #f6dd9a;
}

/* The row list should not sit hard against the scrollbar. */
.meanings-scroll .unity-scroll-view__content-container {
    padding-right: 6px;
}

.meaning-row {
    width: 100%;
    padding: 18px 24px;
    margin-bottom: 12px;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.06);
}

.meaning-word {
    font-size: 32px;
    -unity-font-style: bold;
    color: #f6dd9a;
    letter-spacing: 2px;
}

.meaning-pos {
    font-size: 24px;
    -unity-font-style: italic;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 4px;
}

.meaning-text {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.8);
    white-space: normal;
}

/* Shown once, on the clear that first fills the collection. */
.onboarding-tip {
    width: 100%;
    padding: 18px 24px;
    margin-bottom: 18px;
    border-radius: 21px;
    background-color: rgba(246, 221, 154, 0.12);
    border-width: 2px;
    border-color: rgba(246, 221, 154, 0.35);
    font-size: 25px;
    color: #f6dd9a;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ------------------------------------------------------------------ actions */
/* Smaller than the design's hero button: this card now carries a word list above it, and
   a 176px button pushed the meanings into a cramped scroll. */
.btn-victory-primary {
    width: 540px;
    height: 126px;
    background-image: url("../../Sprites/slices/btn_primary.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-width: 0;
    color: #4a2c05;
    font-size: 39px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 18px;
    transition-property: scale, opacity;
    transition-duration: 0.13s, 0.13s;
}

.btn-victory-primary:hover { scale: 1.04 1.04; }
.btn-victory-primary:active { scale: 0.95 0.95; opacity: 0.88; }

/* Reads as a link and behaves like one - it carries a click handler in LevelCompleteView. */
.victory-subtitle {
    padding: 18px 36px;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 1.5px;
}

/* ============================================================ landscape
   Landscape is short and wide, and the portrait card is the opposite: a tall column that
   ran from the top of the screen to the bottom. The two columns go side by side and the
   vertical rhythm is compressed, so the card spends the width it has instead of the height
   it does not. */
.layout--landscape .victory-card {
    flex-direction: row;

    /* nowrap: the card has exactly two children now, and the buttons live inside the left
       one. Nothing can wrap onto a third row, so the card's height is just the taller of the
       two columns. */
    flex-wrap: nowrap;
    align-items: flex-start;

    justify-content: flex-start;

    /* A share of the screen rather than a fixed pixel width: landscape runs from a phone to
       a desktop window, and a width that suits one leaves the card lost in the other. */
    width: 76%;
    max-width: 100%;
    padding: 3.5% 3.5%;

    /* Height left to the contents. A fixed 88% did decouple the card from the word list, but
       it also stopped the card growing for its own buttons, so the action row ran past the
       bottom edge and "Main Menu" sat outside the panel. */
}

.layout--landscape .victory-col {
    width: 50%;
}

.layout--landscape .victory-col--summary {
    /* flex-start, not center: centring floated this column in the middle of the taller
       word-list column and left a dead band between SCORE and the buttons. */
    justify-content: flex-start;
    padding-right: 5%;
}

/* The actions ride under the stars here, so they need the gap the score line used to give. */
.layout--landscape .victory-actions {
    margin-top: 4%;
}

/* Fills the left column it now lives in. */
.layout--landscape .victory-col--summary > .victory-actions {
    width: 100%;
    padding-right: 0;
}

/* The list is the only thing in the right column now, so it takes the column's height
   rather than a fixed cap - the card's height is set by the left column beside it.
   align-self overrides the card's flex-start, which otherwise sizes this column to its
   content and leaves the bottom half of it empty. */
.layout--landscape .victory-col--detail {
    align-items: flex-start;
}

.layout--landscape .victory-title {
    font-size: 84px;
    margin-bottom: 27px;
}

.layout--landscape .star {
    width: 104px;
    height: 104px;
}

.layout--landscape .stars-row {
    margin-bottom: 27px;
}

/* No cap in landscape: the list is alone in its column, so it should grow to fill whatever
   height the left column sets. The 300px cap was cutting a word row in half and leaving the
   bottom of the column blank. */
/* px, not a percentage: this column's height is auto, so a percentage max-height has no
   parent height to resolve against and Yoga discards it - the list then grows to its full
   content height, pushes the buttons past the card and clips "Main Menu". */
.layout--landscape .meanings-scroll {
    max-height: 700px;
    margin-bottom: 0;
}

/* The word rows were sized for the narrow portrait card; in the wide landscape column the
   same sizes read as fine print. */
.layout--landscape .meanings-heading {
    font-size: 34px;
}

.layout--landscape .meaning-word {
    font-size: 42px;
}

.layout--landscape .meaning-pos {
    font-size: 30px;
}

.layout--landscape .meaning-text {
    font-size: 34px;
}

.layout--landscape .btn-victory-primary {
    width: 100%;
    height: 132px;
    font-size: 44px;
}

.layout--landscape .victory-subtitle {
    padding: 12px 36px;
    font-size: 38px;
}
